set-option -s repeat-time 0
set-option -sg escape-time 0

set -g mode-keys vi

# TPM
set -g @plugin 'tmux-plugins/tpm'

# Common bindings
set -g @plugin 'tmux-plugins/tmux-sensible'

# Destroy window without detaching
set-option -g detach-on-destroy off

# Themes pack
# NOTE: disabled — themepack applies its default theme when TPM runs, which
# overrides any theme sourced from this file.
# set -g @plugin 'jimeh/tmux-themepack'

# Themes

# Nord
# set -g @plugin 'arcticicestudio/nord-tmux'

# Cyan
# set -g @themepack 'powerline/block/cyan'

# set -g @themepack 'powerline/block/gray'

# Rose Pine
# set -g @plugin 'rose-pine/tmux'
# set -g @rose_pine_variant 'main'

# Catppuccin
# set -g @plugin 'catppuccin/tmux#latest'
# set -g @catppuccin_flavor 'mocha' # latte,frappe, macchiato or mocha
# set -g @catppuccin_status_modules_right ''

# Flexoki Dark
# source-file ./flexoki-dark.tmuxtheme

# Ayu Dark
# oh-my-tmux applies its own theme after this file is sourced, so turn it off
# and let ayu-dark.tmuxtheme (sourced at the bottom) own the status bar
tmux_conf_theme="disabled"

# End of themes

# Windows session
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @continuum-restore 'on'

run '~/.tmux/plugins/tpm/tpm'

# Theme last, so it wins over anything a plugin sets
source-file ./ayu-dark.tmuxtheme

